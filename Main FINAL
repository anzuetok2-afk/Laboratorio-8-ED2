/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_SPI1_Init();


  /* USER CODE BEGIN 2 */

  const uint16_t fondo     = 0xEF3F;
  const uint16_t panel     = 0xFFFF;
  const uint16_t morado    = 0x79D5;
  const uint16_t lavanda   = 0xD63B;
  const uint16_t suave     = 0xF7BF;
  const uint16_t texto     = 0x3188;
  const uint16_t secundario = 0x7390;
  const uint16_t rosa      = 0xEAB5;

  LCD_Init();
  LCD_Clear(fondo);

  // ========================================
  // ENCABEZADO
  // ========================================
  FillRect(0, 0, 320, 43, panel);
  FillRect(0, 43, 320, 2, lavanda);

  // Foto del termometro: reducida a 24 x 32.
  static uint16_t termometroPequeno[24 * 32];

  for (int y = 0; y < 32; y++)
  {
      for (int x = 0; x < 24; x++)
      {
          int origenX = x * 61 / 24;
          int origenY = y * 99 / 32;

          termometroPequeno[y * 24 + x] =
              termometroOriginal[origenY * 61 + origenX];
      }
  }

  LCD_Bitmap(12, 5, 24, 32, termometroPequeno);

  LCD_Print("TEMPERATURA CORPORAL",
            49, 9, 1, morado, panel);

  LCD_Print("MONITOR DIGITAL",
            49, 27, 1, secundario, panel);

  // Detalle decorativo del encabezado.
  FillRect(295, 12, 5, 19, lavanda);
  FillRect(288, 19, 19, 5, lavanda);

  // ========================================
  // TARJETA CENTRAL
  // ========================================

  // Sombra y borde.
  FillRect(15, 61, 293, 123, lavanda);
  FillRect(11, 57, 295, 123, lavanda);
  FillRect(13, 59, 291, 119, panel);

  // Franja superior decorativa.
  FillRect(24, 65, 38, 3, morado);

  // ========================================
  // CARITA GRANDE
  // ========================================
  static uint16_t caritaGrande[69 * 69];

  for (int y = 0; y < 69; y++)
  {
      for (int x = 0; x < 69; x++)
      {
          int origenX = 12 + x / 3;
          int origenY = 11 + y / 3;

          uint16_t color =
              carita[origenY * CARITA_ANCHO + origenX];

          if (color == 0x0000 || color == 0xFFFF)
          {
              color = panel;
          }

          caritaGrande[y * 69 + x] = color;
      }
  }

  LCD_Bitmap(22, 89, 69, 69, caritaGrande);

  // ========================================
  // TEMPERATURA CON NUMEROS GRANDES
  // ========================================
  LCD_Print("TEMPERATURA",
            105, 78, 1, secundario, panel);

  // Digitos de siete segmentos: 3, 6 y 7.
  // Cada bit representa uno de los segmentos.
  static const uint8_t segmentos[3] = {
      0x4F, 0x7D, 0x07
  };

  static const uint16_t posicionesX[3] = {
      105, 132, 170
  };

  for (int i = 0; i < 3; i++)
  {
      int x = posicionesX[i];
      int y = 101;
      uint8_t s = segmentos[i];

      // Segmento superior.
      if (s & 0x01)
          FillRect(x + 3, y, 14, 3, morado);

      // Superior derecho.
      if (s & 0x02)
          FillRect(x + 17, y + 3, 3, 13, morado);

      // Inferior derecho.
      if (s & 0x04)
          FillRect(x + 17, y + 19, 3, 13, morado);

      // Segmento inferior.
      if (s & 0x08)
          FillRect(x + 3, y + 32, 14, 3, morado);

      // Inferior izquierdo.
      if (s & 0x10)
          FillRect(x, y + 19, 3, 13, morado);

      // Superior izquierdo.
      if (s & 0x20)
          FillRect(x, y + 3, 3, 13, morado);

      // Segmento central.
      if (s & 0x40)
          FillRect(x + 3, y + 16, 14, 3, morado);
  }

  // Punto decimal.
  FillRect(159, 130, 4, 4, morado);

  // Simbolo de grado y C.
  FillRect(201, 99, 6, 6, morado);
  FillRect(203, 101, 2, 2, panel);

  LCD_Print("C", 213, 105, 2, morado, panel);

  LCD_Print("GRADOS CELSIUS",
            103, 148, 1, secundario, panel);

  // ========================================
  // TERMOMETRO GRANDE DIBUJADO
  // ========================================

  // Contorno morado.
  FillRect(264, 76, 14, 67, morado);
  FillRect(256, 138, 30, 22, morado);
  FillRect(260, 160, 22, 4, morado);

  // Interior claro.
  FillRect(267, 79, 8, 65, suave);
  FillRect(259, 141, 24, 16, suave);

  // Columna rosa.
  FillRect(269, 109, 4, 39, rosa);
  FillRect(263, 145, 16, 9, rosa);
  FillRect(267, 141, 8, 17, rosa);

  // Escala.
  FillRect(281, 85, 10, 2, lavanda);
  FillRect(281, 99, 6, 2, lavanda);
  FillRect(281, 113, 10, 2, lavanda);
  FillRect(281, 127, 6, 2, lavanda);

  // ========================================
  // BARRA INFERIOR
  // ========================================
  FillRect(13, 195, 294, 34, lavanda);
  FillRect(12, 193, 294, 34, panel);

  // Icono pequeno del termometro.
  FillRect(29, 200, 7, 15, morado);
  FillRect(25, 212, 15, 8, morado);
  FillRect(31, 203, 3, 12, rosa);
  FillRect(28, 215, 9, 3, rosa);

  LCD_Print("MIDIENDO...",
            55, 199, 2, morado, panel);

  // Puntos decorativos; permanecen fijos.
  FillRect(257, 208, 5, 5, morado);
  FillRect(270, 208, 5, 5, lavanda);
  FillRect(283, 208, 5, 5, lavanda);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
	while (1) {

    /* USER CODE END WHILE */
	}
    /* USER CODE BEGIN 3 */
  /* USER CODE END 3 */
}

